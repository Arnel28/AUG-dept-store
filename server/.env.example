# --- Server configuration ---
PORT=4000
# URL of the frontend (used for CORS + Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

# --- Auth ---
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# --- Database (SQLite, path is relative to the prisma/ folder) ---
DATABASE_URL="file:./dev.db"

# --- Stripe (optional) ---
# Leave these BLANK to run in demo mode (checkout is simulated, no real payment).
# To enable real Stripe test-mode checkout, paste your TEST keys from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Only needed if you set up a Stripe webhook (see README). Optional for local dev.
STRIPE_WEBHOOK_SECRET=
